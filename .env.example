# Copy this file to .env.local and fill in values. Never commit real keys.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# --- Supabase (Settings → API) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# anon / public key — public by design; RLS makes it read-only for the signed-in user
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — SERVER ONLY (decision engine, deposits). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- The single login (used once by `npm run seed`) ---------------------------
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
# Alpaca paper accounts are in USD
SEED_WALLET_CURRENCY=USD

# --- Alpaca paper trading (https://app.alpaca.markets → Paper → API keys) ---
# Leave blank to run in clearly-labelled SIMULATED market mode.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true

# --- Scheduler -----------------------------------------------------------------
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cycle.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Optional engine tuning (defaults shown) ------------------------------------
# WATCHLIST=AAPL,MSFT,NVDA,BTC/USD
# ENGINE_MOMENTUM_WEIGHT=0.6
# ENGINE_SENTIMENT_WEIGHT=0.4
# ENGINE_BUY_THRESHOLD=0.25
# ENGINE_SELL_THRESHOLD=-0.25
# ENGINE_POSITION_SIZE_PCT=0.1
# ENGINE_MAX_POSITION_PCT=0.3
# ENGINE_MIN_ORDER=10
# ENGINE_NEWS_LOOKBACK_HOURS=72
# NEXT_PUBLIC_DISPLAY_TIMEZONE=Africa/Johannesburg
